        "valid_from": {
          "title": "Valid From",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "tenant_id",
        "application_id",
        "source",
        "author",
        "reason",
        "created_at",
        "valid_from",
        "expires_at"
